# Orbitrack Executive frontend environment.
# Copy to `.env.local` for local React/Tauri development.
# Never place service-role keys in frontend env files.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional local owner bypass for isolated UI work only.
# Leave disabled for security, staging, and release builds.
VITE_EXECUTIVE_OWNER_MODE=0
